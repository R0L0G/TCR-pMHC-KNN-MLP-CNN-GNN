# ---------------------------------------------------------------------------
# Git LFS — wyłącznie duże pliki binarne.
# Wzorce muszą być ustalone PRZED pierwszym `git add` plików, których dotyczą,
# inaczej trafią do zwykłej historii i trzeba będzie użyć `git lfs migrate`.
# ---------------------------------------------------------------------------

# Dane: splity Train/Val/Test, indeksy podgrafów, embeddingi MHC (~32 MB, 8 plików)
*.pkl filter=lfs diff=lfs merge=lfs -text

# Checkpointy: best_*.pt + Wyniki_Ablation/*/checkpoint.pt (~27 MB, 9 plików)
*.pt filter=lfs diff=lfs merge=lfs -text

